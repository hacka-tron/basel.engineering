MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=glassbox
MYSQL_PASSWORD=glassbox
MYSQL_DATABASE=glassbox
REDIS_URL=redis://redis:6379/0

# Both API and ingestion must use the same provider and embedding model.
# Use fake for local/offline development. Re-ingest both corpora after switching models.
GLASSBOX_PROVIDER=fake
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Set a stable, secret salt and trusted proxy CIDRs in production.
GLASSBOX_DAILY_LLM_CAP=100
GLASSBOX_IP_HASH_SALT=
GLASSBOX_TRUSTED_PROXY_CIDRS=
