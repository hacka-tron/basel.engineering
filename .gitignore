# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node (for later frontend work)
node_modules/
dist/
.expo/

# Env
.env
.env.*
!.env.example

# Installed agent skills (regenerable from skills-lock.json via `npx skills`)
.agents/
.claude/

# Git worktrees for isolated task execution
.worktrees/

# OS / editor
.DS_Store
.vscode/
.idea/

# Terraform local working data and bootstrap state (keep outside Git)
**/.terraform/
**/terraform.tfstate*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example

# Answer eval runs (eval/run_answers.py); committed baselines live in eval/baselines/
eval/runs/

# The owner's private About Basel repo, checked out here only by release.yml
# (DESIGN-003 §1.2). Never commit it: this repo is public.
corpus/about-me-private/
