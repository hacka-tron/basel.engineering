# The private About Basel checkout (release.yml): only Markdown under its
# about-me/ folder and the owner-approved example answers (prompt v18 few-shots,
# read by the API, never ingested: the scanner reads only about-me/*.md) go into
# the image; never its .git, README, LICENSE or anything else from that repo.
corpus/about-me-private/**
!corpus/about-me-private/about-me/**/*.md
!corpus/about-me-private/examples/approved-answers.yaml
corpus/about-me-private/about-me/**/.*
corpus/about-me-private/about-me/**/.*/**
